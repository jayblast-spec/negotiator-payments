# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave PAYPAL_CLIENT_ID empty to run everything as a dry run.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional. Without it the payout memo comes from a plain template.
GROQ_API_KEY=

# Optional. When set, approvals are decided by Aegis instead of the local
# policy file's approval_threshold. Agent key only (aeg_agt_...). Never put
# an owner key (aeg_own_...) in this file.
AEGIS_AGENT_KEY=
AEGIS_BASE_URL=https://aegistrust.digital
AEGIS_SCOPES=payments

# Spending policy and decision log locations.
SPEND_POLICY_FILE=spend_policy.json
SPEND_LOG_PATH=spend_decisions.jsonl

# Demo deal. DEMO_VENDOR_PAYPAL_EMAIL must be a sandbox personal account
# email for a real sandbox payout to land anywhere.
DEMO_VENDOR=Example Vendor Co
DEMO_VENDOR_PAYPAL_EMAIL=vendor@example.com
DEMO_PURCHASE_REQUEST=500 units of packaging tape
DEMO_AGREED_PRICE=250.00
